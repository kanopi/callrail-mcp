# CallRail API v3 credentials
# Create a key in CallRail: Settings → Integrations → API Keys → "Create New API v3 Key"
CALLRAIL_API_KEY=your_api_key_here

# Optional: default account id (the "a/{account_id}" segment of API paths).
# If set, tools that take an account_id argument will use this when omitted.
# Find it via the list_accounts tool, or in your CallRail dashboard URL.
CALLRAIL_ACCOUNT_ID=
